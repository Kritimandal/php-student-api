{
    "name": "kritimandal/php-student-api",
    "description": "REST API for student records in plain PHP with PDO, MySQL stored procedures and triggers",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
